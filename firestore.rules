rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ Put the two real login emails here (lowercase). Nobody else can read or write anything.
    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['person1@example.com', 'person2@example.com'];
    }
    function me() { return request.auth.uid; }
    function incoming() { return request.resource.data; }
    function onlyChanges(keys) { return incoming().diff(resource.data).affectedKeys().hasOnly(keys); }

    // Profiles: both can read, each edits only their own
    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && me() == uid;
    }

    // Online status + typing
    match /presence/{uid} {
      allow read: if isMember();
      allow write: if isMember() && me() == uid;
    }

    // Each person's Memories PIN hash — only they can see it
    match /pins/{uid} {
      allow read, write: if isMember() && me() == uid;
    }

    // Chat
    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && incoming().from == me()
        && incoming().to != me()
        && incoming().type in ['text', 'image', 'video', 'voice']
        && (!('text' in incoming()) || incoming().text.size() <= 4000);
      // the receiver marks delivered / read — nothing else
      allow update: if isMember() && resource.data.to == me() && onlyChanges(['deliveredAt', 'readAt']);
      allow delete: if isMember() && resource.data.from == me();
    }

    // Shared memories (image lives in Cloudinary, only the URL is stored)
    match /memories/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me();
      allow update, delete: if isMember() && resource.data.byUid == me();
    }

    match /memorableMovements/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me() && incoming().text.size() <= 400;
      allow update, delete: if isMember() && resource.data.byUid == me();
    }

    // Live-call signalling + metadata (no media is ever stored)
    match /calls/{callId} {
      allow read: if isMember();
      allow create: if isMember() && incoming().callerId == me() && incoming().calleeId != me();
      allow update: if isMember()
        && (resource.data.callerId == me() || resource.data.calleeId == me())
        && incoming().callerId == resource.data.callerId
        && incoming().calleeId == resource.data.calleeId;
      match /{side}/{candidateId} {
        allow read, write: if isMember() && side in ['callerCandidates', 'calleeCandidates'];
      }
    }

    // In-app notifications: sent by one, read only by the receiver
    match /notifications/{id} {
      allow read, delete: if isMember() && resource.data.to == me();
      allow create: if isMember() && incoming().from == me();
      allow update: if isMember() && resource.data.to == me() && onlyChanges(['read']);
    }

    // Shared settings (background image)
    match /settings/{id} {
      allow read, write: if isMember();
    }

    // Kept so the older "WE" app in this project keeps working
    match /moments/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me();
      allow delete: if isMember() && resource.data.byUid == me();
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
