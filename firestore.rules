rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The two login emails (lowercase, each in its own quotes). Nobody else can read or write anything.
    function isMember() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in ['kothakulasagar9380@gmail.com', 'anushaa0404@gmail.com'];
    }
    function me() { return request.auth.uid; }
    function incoming() { return request.resource.data; }
    function onlyChanges(keys) { return incoming().diff(resource.data).affectedKeys().hasOnly(keys); }

    // Profiles: both can read, each edits only their own
    match /users/{uid} {
      allow read: if isMember();
      allow create, update: if isMember() && me() == uid;
    }

    // Online status + typing
    match /presence/{uid} {
      allow read: if isMember();
      allow write: if isMember() && me() == uid;
    }

    // "Together": last position, only while the app is open and only if that person turned it on
    match /locations/{uid} {
      allow read: if isMember();
      allow write: if isMember() && me() == uid;
    }

    // Each phone's notification token(s): both can read (to notify each other), each writes only their own
    match /pushTokens/{uid} {
      allow read: if isMember();
      allow write: if isMember() && me() == uid;
    }

    // Each person's Memories PIN hash — only they can see it
    match /pins/{uid} {
      allow read, write: if isMember() && me() == uid;
    }

    // Chat
    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember()
        && incoming().from == me()
        && incoming().to != me()
        && incoming().type in ['text', 'image', 'video', 'voice', 'sticker']
        && (!('text' in incoming()) || incoming().text.size() <= 4000);
      // the receiver marks delivered / read; the sender can edit the text of their own message
      allow update: if isMember() && (
        (resource.data.to == me() && onlyChanges(['deliveredAt', 'readAt']))
        || (resource.data.from == me() && onlyChanges(['text', 'editedAt'])
            && incoming().text is string && incoming().text.size() <= 4000)
      );
      // the sender can delete any time ("Delete for both"); either app can remove messages older than
      // 10 days, which both phones have already saved locally (only the last 10 days stay in Firebase)
      allow delete: if isMember() && (
        resource.data.from == me()
        || resource.data.createdAt < request.time - duration.value(10, 'd')
      );
    }

    // Meal check-in: one document per person per day, named <uid>_<date>
    match /meals/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && incoming().uid == me() && id == me() + '_' + incoming().date;
    }

    // "Our stickers": a shared sticker pack (pictures live in Cloudinary)
    match /stickers/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me() && incoming().url is string;
      allow delete: if isMember();
    }

    // Shared memories (image lives in Cloudinary, only the URL is stored)
    match /memories/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me();
      allow update: if isMember() && resource.data.byUid == me() && incoming().byUid == me();
      allow delete: if isMember() && resource.data.byUid == me();
    }

    match /memorableMovements/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me() && incoming().text.size() <= 400;
      allow update: if isMember() && resource.data.byUid == me() && incoming().byUid == me() && incoming().text.size() <= 400;
      allow delete: if isMember() && resource.data.byUid == me();
    }

    // Wishlist. "together": both can see it and either can tick it off.
    // "personal": only the person who added it can read it at all. The list can't be changed after adding.
    match /wishes/{id} {
      allow read: if isMember() && (resource.data.scope == 'together' || resource.data.byUid == me());
      allow create: if isMember()
        && incoming().byUid == me()
        && incoming().scope in ['together', 'personal']
        && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120;
      allow update: if isMember()
        && incoming().scope == resource.data.scope
        && incoming().byUid == resource.data.byUid
        && (
          (resource.data.byUid == me() && incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 120)
          || (resource.data.scope == 'together' && onlyChanges(['done', 'doneAt', 'doneBy', 'doneByName']))
        );
      allow delete: if isMember() && resource.data.byUid == me();
    }

    // Live-call signalling + metadata (no media is ever stored)
    match /calls/{callId} {
      allow read: if isMember();
      allow create: if isMember() && incoming().callerId == me() && incoming().calleeId != me();
      allow update: if isMember()
        && (resource.data.callerId == me() || resource.data.calleeId == me())
        && incoming().callerId == resource.data.callerId
        && incoming().calleeId == resource.data.calleeId;
      match /{side}/{candidateId} {
        allow read, write: if isMember() && side in ['callerCandidates', 'calleeCandidates'];
      }
    }

    // In-app notifications: sent by one, read only by the receiver
    match /notifications/{id} {
      allow read, delete: if isMember() && resource.data.to == me();
      allow create: if isMember() && incoming().from == me();
      allow update: if isMember() && resource.data.to == me() && onlyChanges(['read']);
    }

    // Shared settings: background, app name / icon / notification wording, birthdays
    match /settings/{id} {
      allow read, write: if isMember();
    }

    // Kept so the older "WE" app in this project keeps working
    match /moments/{id} {
      allow read: if isMember();
      allow create: if isMember() && incoming().byUid == me();
      allow delete: if isMember() && resource.data.byUid == me();
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
